# Analytics — use um dos dois (ou ambos)
# Google Analytics 4: crie uma propriedade em analytics.google.com e cole o ID (ex: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Plausible: seu domínio cadastrado (ex: pequiqa.com.br)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Formulário de contato (Resend)
# Crie uma conta em https://resend.com e gere uma API key
RESEND_API_KEY=
# E-mail que recebe as mensagens do formulário
CONTACT_TO_EMAIL=contato@pequiqa.com.br
