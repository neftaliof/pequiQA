# Analytics — use um dos dois (ou ambos)
# Google Analytics 4: crie uma propriedade em analytics.google.com e cole o ID (ex: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Plausible: seu domínio cadastrado (ex: pequiqa.com.br)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Formulário de contato (Formspree)
# Crie um form em https://formspree.io e cole o ID do form (ex: xyzabcde)
NEXT_PUBLIC_FORMSPREE_FORM_ID=
